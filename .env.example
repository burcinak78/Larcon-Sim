# Lokal: bu dosyayı .env olarak kopyala ve değerleri değiştir.
# Prod .env sunucuda durur, repoya girmez.

# Image adlandırma (TeamCity/Harbor'da override edilir)
REGISTRY=larcon-sim
IMAGE_TAG=local

# Dışarı açılan port (LB bu porta düz HTTP ile gelir)
FRONTEND_PORT=3000

# Backend
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=larcon
POSTGRES_USER=larcon
POSTGRES_PASSWORD=change-me-postgres

# Object storage (MinIO / S3-uyumlu) — en az 8 karakter
STORAGE_ROOT_USER=larcon-admin
STORAGE_ROOT_PASSWORD=change-me-storage
